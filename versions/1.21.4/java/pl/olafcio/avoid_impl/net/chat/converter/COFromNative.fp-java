import pl.olafcio.avoid.net.item.component.map.ItemComponentMapNative;
import pl.olafcio.avoid.net.item.ItemNative;
import net.minecraft.core.component.PatchedDataComponentMap;

{
    input.getStyle().getClickEvent() instanceof ClickEvent.OpenFile(String path) ? new Click.StartFile(path) :
    input.getStyle().getClickEvent().getAction() == ClickEvent.Action.OPEN_FILE ? new Click.StartFile(input.getStyle().getClickEvent().getValue()) :
}

{
    input.getStyle().getClickEvent() instanceof ClickEvent.OpenUrl(URI url) ? new Click.StartURL(url) :
    input.getStyle().getClickEvent().getAction() == ClickEvent.Action.OPEN_URL ? new Click.StartURL(URI.create(input.getStyle().getClickEvent().getValue())) :
}

{
    input.getStyle().getClickEvent() instanceof ClickEvent.CopyToClipboard(String text) ? new Click.Copy(text) :
    input.getStyle().getClickEvent().getAction() == ClickEvent.Action.COPY_TO_CLIPBOARD ? new Click.Copy(input.getStyle().getClickEvent().getValue()) :
}

{
    input.getStyle().getClickEvent() instanceof ClickEvent.ChangePage(int page) ? new Click.SwitchPage(page) :
    input.getStyle().getClickEvent().getAction() == ClickEvent.Action.CHANGE_PAGE ? new Click.SwitchPage(Integer.parseInt(input.getStyle().getClickEvent().getValue())) :
}

{
    input.getStyle().getClickEvent() instanceof ClickEvent.RunCommand(String cmd) ? new Click.ChatCommand(cmd) :
    input.getStyle().getClickEvent().getAction() == ClickEvent.Action.RUN_COMMAND ? new Click.ChatCommand(input.getStyle().getClickEvent().getValue()) :
}

{
    input.getStyle().getClickEvent() instanceof ClickEvent.SuggestCommand(String msg) ? new Click.ChatSuggest(msg) :
    input.getStyle().getClickEvent().getAction() == ClickEvent.Action.SUGGEST_COMMAND ? new Click.ChatSuggest(input.getStyle().getClickEvent().getValue()) :
}

{
    input.getStyle().getHoverEvent() instanceof HoverEvent.ShowText(Component text) ? new Hover.ViewText(from(text)) :
    input.getStyle().getHoverEvent().getValue(HoverEvent.Action.SHOW_TEXT) instanceof Component text ? new Hover.ViewText(from(text)) :
}

{
    input.getStyle().getHoverEvent() instanceof HoverEvent.ShowEntity(HoverEvent.EntityTooltipInfo info) ? new Hover.ViewEntity(new Hover.EntityTooltip(EntityTypeNative.convertFrom(info.type), info.uuid, info.name.map(COFromNative::from).orElse(null))) :
    input.getStyle().getHoverEvent().getValue(HoverEvent.Action.SHOW_ENTITY) instanceof HoverEvent.EntityTooltipInfo info ? new Hover.ViewEntity(new Hover.EntityTooltip(EntityTypeNative.convertFrom(info.type), info.id, info.name.map(COFromNative::from).orElse(null))) :
}

{
    input.getStyle().getHoverEvent() instanceof HoverEvent.ShowItem(ItemStack stack) ? new Hover.ViewItem(ItemStackNative.convertFrom(stack)) :
    input.getStyle().getHoverEvent().getValue(HoverEvent.Action.SHOW_ITEM) instanceof HoverEvent.ItemStackInfo stack ? new Hover.ViewItem(new pl.olafcio.avoid.net.item.stack.ItemStack(ItemNative.convert(stack.item.value()), stack.count, ItemComponentMapNative.convertFrom(new PatchedDataComponentMap(stack.item.value().components(), stack.components.map, true)))) :
}
