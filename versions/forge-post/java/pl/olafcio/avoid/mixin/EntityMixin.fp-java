    @WrapOperation(at = @At(value = "INVOKE", target = "Lnet/minecraftforge/common/extensions/IForgeEntity;isInFluidType(Ljava/util/function/BiPredicate;)Z"), method = "isInWaterOrSwimmable")

    public boolean isInWaterOrSwimmable__inSwimmable(IForgeEntity entity, BiPredicate<FluidType, Double> predicate, Operation<Boolean> original) {
        for (var entry : FluidsNative.classes.entrySet()) {
            if (((IForgeEntity) this).isInFluidType((ft, d) -> {
                System.out.println("FT:" + ft);
                return false;
            }, false)) {
                if (entry.getKey().isAnnotationPresent(_swimmable.class)) {
                    //noinspection resource
                    return true;
                }
            }
        }

        return original.call(entity, predicate);
    }

    @Unique
}

