{
    public final class Blocks {
    public final class Blocks {
        public static final HashMap<ResourceKey<BlockSoundSet>, BlockSoundSet> SOUND_SETS
                      = new HashMap<>();

        private static ResourceKey<BlockSoundSet> addSoundSet(Identification blockID, BlockSoundSet soundset) {
            var key = ResourceKey.create(Registries.BLOCK_SOUND_SET, IdentificationNative.convert(blockID));
            SOUND_SETS.put(key, soundset);
            return key;
        }
