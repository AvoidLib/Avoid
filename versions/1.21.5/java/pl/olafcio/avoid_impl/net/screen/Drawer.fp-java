{
    Drawer() {}
    Drawer() {}

    private void drawShiiTextForMe(
        net.minecraft.client.gui.Font font, FormattedCharSequence formattedCharSequence,
        org.joml.Matrix4f pose, int x, int y, int color, int background, boolean shadow,
        Void useless
    ) {
        font.drawInBatch(formattedCharSequence, (float)x, (float)y, color, shadow, pose, this.graphics.bufferSource, DisplayMode.NORMAL, background, 15728880 /* <- was is das? */);
    }

    private void drawShiiFillFor(
        com.mojang.blaze3d.pipeline.RenderPipeline pipeline,
        org.joml.Matrix4f pose,
        int x, int y, int x2, int y2, int color, int color2,
        Void nothing
    ) {
        var renderType = RenderPipelineMap.MAP.get(pipeline);
        var vertexConsumer = graphics.bufferSource.getBuffer(renderType);

        vertexConsumer.addVertex(pose, (float)x, (float)y, (float)0.0F).setColor(color);
        vertexConsumer.addVertex(pose, (float)x, (float)y2, (float)0.0F).setColor(color2);
        vertexConsumer.addVertex(pose, (float)x2, (float)y2, (float)0.0F).setColor(color2);
        vertexConsumer.addVertex(pose, (float)x2, (float)y, (float)0.0F).setColor(color);
    }

    private void drawShiiBlitFor(
        com.mojang.blaze3d.pipeline.RenderPipeline renderLayer,
        org.joml.Matrix4f matrix4f,
        int x0, int y0, int x1, int y1, float u0, float u1, float v0, float v1, int color,
        Void nothing
    ) {
        var vertexConsumer = this.graphics.bufferSource.getBuffer(RenderPipelineMap.MAP.get(renderLayer));

        vertexConsumer.addVertex(matrix4f, (float)x0, (float)y0, 0.0F).setUv(u0, v0).setColor(color);
        vertexConsumer.addVertex(matrix4f, (float)x0, (float)y1, 0.0F).setUv(u0, v1).setColor(color);
        vertexConsumer.addVertex(matrix4f, (float)x1, (float)y1, 0.0F).setUv(u1, v1).setColor(color);
        vertexConsumer.addVertex(matrix4f, (float)x1, (float)y0, 0.0F).setUv(u1, v0).setColor(color);
    }
}

