{
    return this.graphics.pose();

    //== replacement ==//

    var poses = this.graphics.pose().poses;
    var stack = new Matrix3x2fStack(poses.size() + 1);

    for (var pose : poses) {
        // damn I don't have the useless Z what do i do
        stack.scale(pose.pose.m00(), pose.pose.m11());
        stack.translate(pose.pose.m30(), pose.pose.m31());
    //  stack.rotate(pose.pose.); TODO okay i actually don't know what to put there rotating is messy

        stack.pushMatrix();
    }

    return stack;
}

