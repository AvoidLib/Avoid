{
    public final class EntityTypes {
    public final class EntityTypes {
        private static void injectDefaultAttributes(EntityType<? extends LivingEntity> key, Supplier<AttributeSupplier> value) {
            AvoidDefer.afterFreeze(() -> {
                var suppliers = (Map<EntityType<? extends LivingEntity>, AttributeSupplier>)
                                Reflect.get(DefaultAttributes.class, "SUPPLIERS", Map.class);

                if (suppliers instanceof ImmutableMap<EntityType<? extends LivingEntity>, AttributeSupplier>)
                    suppliers = new HashMap<>(suppliers);

                suppliers.put(key, value.get());

                Reflect.setUnsafe(DefaultAttributes.class, "SUPPLIERS", suppliers);
            });
        }
}
