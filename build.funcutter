///////////////
/// LOADERS ///
///////////////

$ neoforge
: {@name}
! neoforge-{@name}_compat
! neoforge-post
neoforge=1
merge=["fabric", "neoforge"]
neo_version={}

$ sponge
: {@name}
sponge=1
publish=1

$ paper
: {@name}
! mixinless
! mixinless-{@name}
paper=1
publish=1
dev_mappings=OBFUSCATED
alpha=1

$ quilt
: {@name}
quilt=1
publish=1

////////////////
/// VERSIONS ///
////////////////

# 1.21.10
minecraft_version=1.21.10
