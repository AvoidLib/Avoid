/////////////
/// PARTS ///
/////////////

$ no-placeholders
text_papi_version=-

$ mixinless
mixinless=1

///////////////
/// LOADERS ///
///////////////

$ forge
! fml
: {@name}
! fml-{@name}_compat
! forge-{@name}_compat
! forge-post
! no-placeholders
forge=1
publish=1
dev_mappings=OBFUSCATED
alpha=1

$ neoforge
! fml
: {@name}
! fml-{@name}_compat
! neoforge-{@name}_compat
! neoforge-post
! no-placeholders
neoforge=1
merge=["fabric", "neoforge"]
neo_version={}
dev_mappings=OBFUSCATED

$ sponge
: {@name}
: no-placeholders
sponge=1
publish=1
dev_mappings=OBFUSCATED

$ paper
: {@name}
: mixinless
paper=1
publish=1
dev_mappings=OBFUSCATED
alpha=1

$ quilt
: {@name}
quilt=1
publish=1

